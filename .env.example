# MongoDB Configuration
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/reflow?retryWrites=true&w=majority&appName=Cluster0
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=reflow
MONGODB_CONNECTION_TIMEOUT_MS=5000
# Set to 'atlas' for Render/cloud, 'local' for local dev
DATABASE_MODE=atlas

# Server
HOST=0.0.0.0
PORT=8000

# Hardware Node Defaults
DEFAULT_DEVICE_ID=ESP32-001
CARETAKER_ALERT_COOLDOWN_SEC=15
EDGE_HARDWARE=Raspberry Pi 4 Model B
